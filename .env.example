# Mr Pizza Badiana — one .env per shop's copy of the app
EXPO_PUBLIC_APP_NAME=Mr Pizza Badiana
EXPO_PUBLIC_API_BASE=https://sialkotians.com
# WP admin → Users → the shop's owner profile → "Shop key"
EXPO_PUBLIC_SHOP_KEY=paste-shop-key-here
EXPO_PUBLIC_PRIMARY_COLOR="#e9dd12"
EXPO_PUBLIC_ACCENT_COLOR="#8a6a00"
# Public privacy policy page (Play Store). Shown in My account when set.
EXPO_PUBLIC_PRIVACY_URL=https://sialkotians.com/mr-pizza-badiana-privacy-policy/

# Native app identity (used by app.config.js)
APP_NAME=Mr Pizza Badiana
APP_SLUG=mrpizzabadiana
APP_BUNDLE_ID=mr.pizza.badiana

# Push notifications: EAS project id (npx eas init) and google-services.json for APP_BUNDLE_ID
EAS_PROJECT_ID=
GOOGLE_SERVICES_FILE=./google-services.json
